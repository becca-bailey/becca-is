---
interface Props {
	date: string;
}

const { date } = Astro.props;
---

<aside class="author-note" aria-label={`Author's note, ${date}`}>
	<p class="author-note-label font-sans text-xs font-medium tracking-wide uppercase text-text-muted">
		Author's note · {date}
	</p>
	<div class="author-note-body text-text">
		<slot />
	</div>
</aside>
