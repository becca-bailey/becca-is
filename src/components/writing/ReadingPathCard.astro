---
import Card from '../Card.astro';
import type { ReadingPathEntry } from '@/lib/content';

interface Props {
	path: ReadingPathEntry;
	essayCount?: number;
}

const { path, essayCount } = Astro.props;
const { title, description, slug } = path.data;
const meta =
	essayCount !== undefined && essayCount > 0
		? `${essayCount} ${essayCount === 1 ? 'essay' : 'essays'}`
		: undefined;
---

<Card href={`/paths/${slug}`} title={title} summary={description} meta={meta} linkLabel="View path" />
