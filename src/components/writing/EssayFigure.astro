---
import { Image } from 'astro:assets';
import type { ImageMetadata } from 'astro';

interface Props {
	src: ImageMetadata;
	alt: string;
}

const { src, alt } = Astro.props;
const isGif = src.format === 'gif';
---

<figure class="essay-figure">
	{
		isGif ? (
			<img
				src={src.src}
				alt={alt}
				width={src.width}
				height={src.height}
				class="image-outline w-full"
				loading="lazy"
			/>
		) : (
			<Image src={src} alt={alt} class="image-outline w-full" />
		)
	}
	{
		Astro.slots.has('default') && (
			<figcaption class="essay-figure-credit font-sans text-sm text-text-muted">
				<slot />
			</figcaption>
		)
	}
</figure>
