---
import { formatDate, getDisplayDate, type WritingEntry } from '@/lib/content';

interface Props {
	entries: WritingEntry[];
}

const { entries } = Astro.props;
---

{
	entries.length > 0 && (
		<section class="related-essays">
			<h2 class="mb-4 font-sans text-lg font-medium tracking-tight">Related essays</h2>
			<ul class="space-y-6">
				{entries.map((entry) => {
					const displayDate = getDisplayDate(entry);
					return (
						<li class="border-t border-border pt-6 first:border-t-0 first:pt-0">
							<time
								datetime={displayDate.toISOString()}
								class="mb-2 block font-sans text-sm text-text-muted"
							>
								{formatDate(displayDate)}
							</time>
							<h3 class="mb-1 font-sans text-xl font-medium">
								<a
									href={`/writing/${entry.id}`}
									class="text-text no-underline hover:underline"
								>
									{entry.data.title}
								</a>
							</h3>
							{entry.data.subtitle && (
								<p class="mb-1 font-sans text-sm font-medium text-text-muted">
									{entry.data.subtitle}
								</p>
							)}
							<p class="text-text-muted">{entry.data.description}</p>
						</li>
					);
				})}
			</ul>
		</section>
	)
}
