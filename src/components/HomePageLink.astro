---
interface Props {
	href: string;
	external?: boolean;
	class?: string;
}

const { href, external = false, class: className } = Astro.props;

const linkClasses =
	'block max-w-[14rem] font-sans text-sm font-medium leading-snug text-text no-underline underline-offset-4 transition-colors hover:text-text-hover hover:underline focus-visible:outline-2 focus-visible:outline-offset-2 focus-visible:outline-focus-ring';
---

<a
	href={href}
	class:list={[linkClasses, className]}
	{...(external ? { target: '_blank', rel: 'noopener noreferrer' } : {})}
>
	<slot /> <span aria-hidden="true">&rarr;</span>
</a>
