---
interface Props {
	href: string;
	external?: boolean;
	class?: string;
}

const { href, external = false, class: className } = Astro.props;

const linkClasses =
	'block max-w-[14rem] font-sans text-sm font-medium leading-snug text-text underline-offset-4 transition-colors hover:text-[#3D3832] hover:underline';
---

<a
	href={href}
	class:list={[linkClasses, className]}
	{...(external ? { target: '_blank', rel: 'noopener noreferrer' } : {})}
>
	<slot /> &rarr;
</a>
