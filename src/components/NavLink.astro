---
import { cn, isNavActive } from '@/lib/utils';
import { navLinkVariants } from '@/lib/variants';
import type { HTMLAttributes } from 'astro/types';

interface Props extends HTMLAttributes<'a'> {
	href: string;
	context?: 'header' | 'mobile' | 'body';
	class?: string;
}

const { href, context = 'body', class: className, ...rest } = Astro.props;

const isNavContext = context === 'header' || context === 'mobile';
const active = isNavContext && isNavActive(href, Astro.url.pathname);
---

<a
	href={href}
	class={cn(navLinkVariants({ context, active }), className)}
	aria-current={active ? 'page' : undefined}
	{...rest}
>
	<slot />
</a>
