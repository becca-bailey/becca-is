---
import { Image } from 'astro:assets';
import type { ImageMetadata } from 'astro';

interface Props {
	title: string;
	intro: string;
	image: ImageMetadata;
}

const { title, intro, image } = Astro.props;
---

<header class="mb-7 md:mb-8">
	<div class="mb-3 flex items-center gap-3 md:gap-4">
		<Image
			src={image}
			alt=""
			class="section-doodle h-10 w-10 md:h-20 md:w-20"
			width={160}
			height={160}
			aria-hidden="true"
		/>
		<h2 class="mb-0">{title}</h2>
	</div>
	<p class="editorial-prose text-text-muted">{intro}</p>
</header>
