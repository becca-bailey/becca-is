---
import { Image } from 'astro:assets';
import type { ImageMetadata } from 'astro';

interface Props {
	src: ImageMetadata;
	alt: string;
	caption: string;
}

const { src, alt, caption } = Astro.props;
---

<figure class="mb-8">
	<Image
		src={src}
		alt={alt}
		class="technical-preview-image"
		width={960}
		height={600}
		loading="eager"
	/>
	<figcaption class="mt-2 font-sans text-sm text-text-muted">{caption}</figcaption>
</figure>
