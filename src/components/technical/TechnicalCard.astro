---
import { Image } from 'astro:assets';
import {
	getTechnicalCardMeta,
	technicalUrl,
	truncateExcerpt,
	type TechnicalEntry,
} from '@/lib/content';
import TechnicalPlaceholderThumb from './TechnicalPlaceholderThumb.astro';

interface Props {
	entry: TechnicalEntry;
	variant?: 'default' | 'compact';
}

const { entry, variant = 'default' } = Astro.props;
const { title, summary, pubDate, thumbnail, venue, host, type } = entry.data;
const href = technicalUrl(entry.id);
const isCompact = variant === 'compact';
const excerpt = truncateExcerpt(summary, isCompact ? 100 : 160);
const meta = getTechnicalCardMeta(entry);
const linkClasses =
	'mt-auto font-sans text-sm font-medium text-text underline-offset-4 transition-colors hover:text-[#3D3832] hover:underline';
const bodyPadding = isCompact ? 'p-5 md:p-6' : 'p-6 md:p-8';
---

<article class="group flex h-full flex-col overflow-hidden rounded-md border border-border bg-background transition-colors hover:bg-peach/20">
	{
		thumbnail ? (
			<a href={href} class="block shrink-0 no-underline" tabindex="-1" aria-hidden="true">
				<Image
					src={thumbnail}
					alt=""
					class="aspect-[16/10] w-full object-cover"
					width={640}
					height={400}
				/>
			</a>
		) : (
			<TechnicalPlaceholderThumb
				title={title}
				type={type}
				pubDate={pubDate}
				venue={venue}
				host={host}
				href={href}
			/>
		)
	}
	<div class:list={['flex min-h-[10rem] flex-1 flex-col', bodyPadding]}>
		<h3 class="mb-2 font-sans text-lg font-medium leading-snug md:text-xl">
			<a href={href} class="text-text no-underline group-hover:underline">
				{title}
			</a>
		</h3>
		{meta && <p class="mb-3 font-sans text-sm text-text-muted">{meta}</p>}
		<p class:list={['flex-1 text-text-muted', isCompact ? 'mb-4 line-clamp-2 text-sm leading-relaxed' : 'mb-6']}>
			{excerpt}
		</p>
		<a href={href} class={linkClasses}>
			Read more &rarr;
		</a>
	</div>
</article>
