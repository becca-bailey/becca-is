---
import Card from '../Card.astro';
import { getTechnicalCardMeta, technicalUrl, truncateExcerpt, type TechnicalEntry } from '@/lib/content';
import TechnicalPlaceholderThumb from './TechnicalPlaceholderThumb.astro';

interface Props {
	entry: TechnicalEntry;
	/** Compact cards drop the thumbnail, for the home page. */
	variant?: 'default' | 'compact';
}

const { entry, variant = 'default' } = Astro.props;
const { title, summary, pubDate, thumbnail, venue, host, type } = entry.data;
const href = technicalUrl(entry.id);
const showMedia = variant !== 'compact';
---

<Card
	href={href}
	title={title}
	image={showMedia ? thumbnail : undefined}
	summary={truncateExcerpt(summary, 160)}
	meta={getTechnicalCardMeta(entry)}
	linkLabel="Read more"
>
	{
		showMedia && !thumbnail && (
			<TechnicalPlaceholderThumb
				slot="media"
				title={title}
				type={type}
				pubDate={pubDate}
				venue={venue}
				host={host}
				href={href}
			/>
		)
	}
</Card>
