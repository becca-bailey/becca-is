---
import ProjectCard from './ProjectCard.astro';
import SectionHeader from './SectionHeader.astro';
import lucy from '../assets/lucy.png';
import { getFeaturedProjects } from '@/lib/content';

const projects = await getFeaturedProjects(3);
---

<section class="reveal mb-12 md:mb-28">
	<SectionHeader
		title="Projects"
		intro="Some of these projects involve software. Some involve fabric, yarn, or a staple gun. All of them reflect things I care about: thoughtful design, careful execution, and making things that last."
		image={lucy}
	/>

	{
		projects.length > 0 ? (
			<div class="reveal-stagger grid gap-6 md:grid-cols-2">
				{projects.map((entry) => (
					<ProjectCard entry={entry} variant="featured" />
				))}
			</div>
		) : (
			<p class="text-text-muted">Featured projects coming soon.</p>
		)
	}
</section>
