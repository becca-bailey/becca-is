---
import EssayCard from './EssayCard.astro';
import SectionHeader from './SectionHeader.astro';
import coffee from '../assets/coffee.png';
import { getFeaturedWriting } from '@/lib/content';

const essays = await getFeaturedWriting(3);
---

<section class="reveal mb-12 md:mb-28">
	<SectionHeader
		title="Featured Writing"
		intro="Essays about technology, work, care, community, and the systems that shape ordinary life."
		image={coffee}
	/>

	{
		essays.length > 0 ? (
			<div class="reveal-stagger grid gap-6 md:grid-cols-2">
				{essays.map((entry) => (
					<EssayCard entry={entry} variant="cover" />
				))}
			</div>
		) : (
			<p class="text-text-muted">Featured essays coming soon.</p>
		)
	}
</section>
