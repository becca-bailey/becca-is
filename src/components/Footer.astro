					href="https://github.com/becca-bailey"
					class="text-sm text-text underline-offset-4 transition-colors hover:text-[#3D3832] hover:underline focus-visible:outline-2 focus-visible:outline-offset-2 focus-visible:outline-blue"
					target="_blank"
					rel="noopener noreferrer"
				>
					GitHub
				</a>
			</nav>
		</div>
		<p class="mt-6 text-center text-sm text-text-muted md:text-left">
			&copy; {year} Becca Bailey. All rights reserved.
		</p>
	</div>
</footer>
