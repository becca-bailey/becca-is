---
import { mailto, site } from '@/lib/site';

const year = new Date().getFullYear();

const footerLinkClasses =
	'inline-block rounded-sm font-sans text-sm text-text underline-offset-4 transition-colors hover:text-[#3D3832] hover:underline focus-visible:outline-2 focus-visible:outline-offset-2 focus-visible:outline-blue py-2 md:py-0';
---

<footer class="mt-16 border-t border-border bg-background">
	<div class="mx-auto max-w-6xl px-4 py-10 md:px-8 md:py-8">
		<div
			class="flex flex-col gap-8 md:flex-row md:items-start md:justify-between md:gap-6"
		>
			<div class="min-w-0">
				<p class="font-sans text-sm font-medium text-text">{site.name}</p>
				<p class="mt-2 font-sans text-sm text-text-muted">
					&copy; {year} {site.name}. All rights reserved.
				</p>
			</div>

			<nav
				class="flex flex-col items-start gap-1 md:flex-row md:flex-wrap md:items-center md:justify-end md:gap-x-6 md:gap-y-2"
				aria-label="Footer navigation"
			>
				<a href={mailto()} class={footerLinkClasses}>
					{site.email}
				</a>
				<a
					href={site.links.linkedin}
					class={footerLinkClasses}
					target="_blank"
					rel="noopener noreferrer"
				>
					LinkedIn
				</a>
				<a
					href={site.links.github}
					class={footerLinkClasses}
					target="_blank"
					rel="noopener noreferrer"
				>
					GitHub
				</a>
				<a
					href={site.links.substack}
					class={footerLinkClasses}
					target="_blank"
					rel="noopener noreferrer"
				>
					Substack
				</a>
			</nav>
		</div>
	</div>
</footer>
