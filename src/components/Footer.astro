---
import { mailto, site } from '@/lib/site';

const year = new Date().getFullYear();
---

<footer class="mt-16 border-t border-border bg-background">
	<div class="mx-auto max-w-6xl px-4 py-8 md:px-8">
		<div class="flex flex-col items-center justify-between gap-6 text-center md:flex-row md:text-left">
			<div>
				<p class="font-sans text-sm text-text">{site.name}</p>
			</div>
			<nav class="flex flex-wrap items-center justify-center gap-x-6 gap-y-2" aria-label="Footer navigation">
				<a
					href={mailto()}
					class="text-sm text-text underline-offset-4 transition-colors hover:text-[#3D3832] hover:underline focus-visible:outline-2 focus-visible:outline-offset-2 focus-visible:outline-blue"
				>
					{site.email}
				</a>
				<a
					href={site.links.linkedin}
					class="text-sm text-text underline-offset-4 transition-colors hover:text-[#3D3832] hover:underline focus-visible:outline-2 focus-visible:outline-offset-2 focus-visible:outline-blue"
					target="_blank"
					rel="noopener noreferrer"
				>
					LinkedIn
				</a>
				<a
					href={site.links.github}
					class="text-sm text-text underline-offset-4 transition-colors hover:text-[#3D3832] hover:underline focus-visible:outline-2 focus-visible:outline-offset-2 focus-visible:outline-blue"
					target="_blank"
					rel="noopener noreferrer"
				>
					GitHub
				</a>
				<a
					href={site.links.substack}
					class="text-sm text-text underline-offset-4 transition-colors hover:text-[#3D3832] hover:underline focus-visible:outline-2 focus-visible:outline-offset-2 focus-visible:outline-blue"
					target="_blank"
					rel="noopener noreferrer"
				>
					Performance Anxiety
				</a>
			</nav>
		</div>
		<p class="mt-6 text-center text-sm text-text-muted md:text-left">
			&copy; {year} {site.name}. All rights reserved.
		</p>
	</div>
</footer>
