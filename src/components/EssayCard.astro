---
import Card from './Card.astro';
import { formatDate, getDisplayDate, truncateExcerpt, type WritingEntry } from '@/lib/content';

interface Props {
	entry: WritingEntry;
	variant?: 'card' | 'list';
}

const { entry, variant = 'card' } = Astro.props;
const { title, subtitle, description, featuredImage } = entry.data;
const displayDate = getDisplayDate(entry);
const href = `/writing/${entry.id}`;
// Imported Substack essays carry their one-line subtitle in `description`.
const summary = subtitle ?? truncateExcerpt(description, 140);
---

{
	variant === 'list' ? (
		<article class="group flex flex-col gap-2 border-b border-border pb-6 last:border-b-0 last:pb-0">
			<time datetime={displayDate.toISOString()} class="font-sans text-sm text-text-muted">
				{formatDate(displayDate)}
			</time>
			<h3 class="font-sans text-xl font-medium">
				<a href={href} class="text-text no-underline group-hover:underline">
					{title}
				</a>
			</h3>
			{subtitle && <p class="font-sans text-sm font-medium text-text-muted">{subtitle}</p>}
			<p class="text-text-muted">{description}</p>
		</article>
	) : (
		<Card
			href={href}
			title={title}
			image={featuredImage}
			summary={summary}
			meta={formatDate(displayDate)}
			datetime={displayDate.toISOString()}
			linkLabel="Read essay"
		/>
	)
}
