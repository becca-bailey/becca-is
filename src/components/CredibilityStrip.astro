---
import { site } from '@/lib/site';

const { conferences, publications } = site.credibility;
const listClasses = 'flex flex-wrap gap-x-2 gap-y-1 font-sans text-sm text-text';
---

<section class="reveal mb-10 border-y border-border py-6 md:mb-14 md:py-8" aria-label="Speaking and publication highlights">
	<div class="grid gap-6 md:grid-cols-2 md:gap-10">
		<div>
			<p class="mb-2 font-sans text-xs font-medium tracking-wide text-text-muted uppercase">
				Speaker at
			</p>
			<p class={listClasses}>
				{
					conferences.map((name, index) => (
						<>
							{index > 0 && <span class="text-text-muted" aria-hidden="true">·</span>}
							<span>{name}</span>
						</>
					))
				}
			</p>
		</div>
		<div>
			<p class="mb-2 font-sans text-xs font-medium tracking-wide text-text-muted uppercase">
				Published by
			</p>
			<p class={listClasses}>
				{
					publications.map((name, index) => (
						<>
							{index > 0 && <span class="text-text-muted" aria-hidden="true">·</span>}
							<span>{name}</span>
						</>
					))
				}
			</p>
		</div>
	</div>
</section>
