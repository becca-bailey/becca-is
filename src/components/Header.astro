---
import NavLink from './NavLink.astro';

const navItems = [
	{ href: '/writing', label: 'Writing' },
	{ href: '/working', label: 'Working' },
	{ href: '/making-things', label: 'Making things' },
	{ href: '/#contact', label: 'Contact' },
];
---

<header class="static border-b border-border bg-background">
	<div class="mx-auto flex max-w-6xl items-center justify-between px-4 py-4 md:px-8">
		<a
			href="/"
			class="rounded-md px-2 py-1 font-sans text-lg font-medium tracking-tight text-text no-underline transition-colors duration-200 hover:bg-peach hover:text-[#3D3832] active:bg-peach/80 focus-visible:outline-2 focus-visible:outline-offset-2 focus-visible:outline-blue md:text-xl"
		>
			Becca Bailey
		</a>

		<nav class="hidden items-center gap-6 md:flex" aria-label="Main navigation">
			{navItems.map((item) => (
				<NavLink href={item.href} context="header">
					{item.label}
				</NavLink>
			))}
		</nav>

		<button
			type="button"
			class="inline-flex items-center justify-center rounded-md p-2 text-text transition-colors duration-200 hover:bg-peach active:bg-peach/80 md:hidden focus-visible:outline-2 focus-visible:outline-offset-2 focus-visible:outline-blue"
			aria-expanded="false"
			aria-controls="mobile-nav"
			aria-label="Open menu"
			data-mobile-menu-toggle
		>
			<svg xmlns="http://www.w3.org/2000/svg" width="24" height="24" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round" aria-hidden="true">
				<line x1="4" x2="20" y1="6" y2="6"></line>
				<line x1="4" x2="20" y1="12" y2="12"></line>
				<line x1="4" x2="20" y1="18" y2="18"></line>
			</svg>
		</button>
	</div>

	<div
		id="mobile-nav"
		class="fixed inset-0 z-50 hidden md:hidden"
		aria-hidden="true"
		data-mobile-nav
	>
		<div class="absolute inset-0 bg-stone-brown/20" data-mobile-nav-backdrop></div>
		<nav
			class="absolute top-0 right-0 flex h-full w-72 flex-col border-l border-border bg-background p-6 shadow-lg"
			aria-label="Mobile navigation"
		>
			<button
				type="button"
				class="mb-6 self-end rounded-md p-2 text-text transition-colors duration-200 hover:bg-peach active:bg-peach/80 focus-visible:outline-2 focus-visible:outline-offset-2 focus-visible:outline-blue"
				aria-label="Close menu"
				data-mobile-menu-close
			>
				<svg xmlns="http://www.w3.org/2000/svg" width="24" height="24" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round" aria-hidden="true">
					<path d="M18 6 6 18"></path>
					<path d="m6 6 12 12"></path>
				</svg>
			</button>
			{navItems.map((item) => (
				<NavLink href={item.href} context="mobile" data-mobile-nav-link>
					{item.label}
				</NavLink>
			))}
		</nav>
	</div>
</header>

<script>
	function setupMobileNav() {
		const toggle = document.querySelector('[data-mobile-menu-toggle]');
		const closeBtn = document.querySelector('[data-mobile-menu-close]');
		const nav = document.querySelector('[data-mobile-nav]');
		const backdrop = document.querySelector('[data-mobile-nav-backdrop]');
		const navLinks = document.querySelectorAll('[data-mobile-nav-link]');

		if (!toggle || !closeBtn || !nav || !backdrop) return;

		const openMenu = () => {
			nav.classList.remove('hidden');
			nav.setAttribute('aria-hidden', 'false');
			toggle.setAttribute('aria-expanded', 'true');
			document.body.style.overflow = 'hidden';
			const firstLink = nav.querySelector('a');
			if (firstLink instanceof HTMLElement) firstLink.focus();
		};

		const closeMenu = () => {
			nav.classList.add('hidden');
			nav.setAttribute('aria-hidden', 'true');
			toggle.setAttribute('aria-expanded', 'false');
			document.body.style.overflow = '';
			if (toggle instanceof HTMLElement) toggle.focus();
		};

		toggle.addEventListener('click', openMenu);
		closeBtn.addEventListener('click', closeMenu);
		backdrop.addEventListener('click', closeMenu);
		navLinks.forEach((link) => link.addEventListener('click', closeMenu));

		document.addEventListener('keydown', (event) => {
			if (event.key === 'Escape' && !nav.classList.contains('hidden')) {
				closeMenu();
			}
		});
	}

	setupMobileNav();
	document.addEventListener('astro:page-load', setupMobileNav);
</script>
