---
import { Image } from 'astro:assets';
import { projectUrl, truncateExcerpt, type ProjectEntry } from '@/lib/content';

interface Props {
	entry: ProjectEntry;
	variant?: 'default' | 'featured';
}

const { entry, variant = 'default' } = Astro.props;
const { title, description, medium, featuredImage, pubDate } = entry.data;
const href = projectUrl(entry.id);
const isFeatured = variant === 'featured';
const year = pubDate?.getFullYear();
const meta = [medium, year].filter(Boolean).join(' · ');
const blurb = isFeatured ? truncateExcerpt(description, 140) : description;
const linkClasses =
	'font-sans text-sm font-medium text-text underline-offset-4 transition-colors hover:text-[#3D3832] hover:underline';
---

<article class="flex h-full flex-col overflow-hidden rounded-md border border-border bg-background transition-colors hover:bg-peach/20">
	<a href={href} class="block shrink-0 no-underline" tabindex="-1" aria-hidden="true">
		<Image
			src={featuredImage}
			alt=""
			class:list={[
				'w-full',
				isFeatured
					? 'aspect-[5/4] bg-stone-brown/5 object-contain p-3'
					: 'aspect-[16/10] object-cover',
			]}
			width={640}
			height={isFeatured ? 512 : 400}
		/>
	</a>
	<div class="flex flex-1 flex-col p-6">
		<h3 class="mb-2 font-sans text-lg font-medium">
			<a href={href} class="text-text no-underline hover:underline">
				{title}
			</a>
		</h3>
		<p class:list={['mb-4 flex-1 text-text-muted', isFeatured && 'line-clamp-3 text-sm leading-relaxed']}>
			{blurb}
		</p>
		{meta && <p class="mb-4 font-sans text-sm text-text-muted">{meta}</p>}
		<a href={href} class={linkClasses}>
			View project &rarr;
		</a>
	</div>
</article>
