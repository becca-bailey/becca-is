---
import Card from './Card.astro';
import { projectImage, projectUrl, truncateExcerpt, type ProjectEntry } from '@/lib/content';

interface Props {
	entry: ProjectEntry;
	/** Use 2 when the card sits directly under the page's h1. */
	headingLevel?: 2 | 3;
}

const { entry, headingLevel = 3 } = Astro.props;
const { title, description, medium, pubDate } = entry.data;
const meta = [medium, pubDate?.getUTCFullYear()].filter(Boolean).join(' · ');
---

<Card
	href={projectUrl(entry.id)}
	title={title}
	headingLevel={headingLevel}
	image={projectImage(entry)}
	summary={truncateExcerpt(description, 160)}
	meta={meta}
	linkLabel="View project"
/>
