---
import Button from './Button.astro';
import { mailto, site } from '@/lib/site';
import { cn } from '@/lib/utils';

interface Props {
	class?: string;
}

const { class: className } = Astro.props;
---

<section
	id="contact"
	class={cn('reveal rounded-md border border-border bg-peach/30 p-8 text-left', className)}
>
	<h2 class="mb-3">{site.contactHeading}</h2>
	<p class="mb-6 text-text-muted">{site.contactIntro}</p>
	<Button href={mailto()}>Send an email</Button>
</section>
