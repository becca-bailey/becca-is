---
import Layout from '../../layouts/Layout.astro';
import ProjectCard from '../../components/ProjectCard.astro';
import RevealScript from '../../components/RevealScript.astro';
import { getPublishedProjects } from '@/lib/content';

const projects = await getPublishedProjects('technical');
---

<Layout
	title="Working — Becca Bailey"
	description="A decade of experience building software, leading teams, and navigating complex technical challenges."
>
	<h1 class="mb-4">Technical Work</h1>
	<p class="reveal mb-10 max-w-prose text-text-muted">
		A decade of experience building software, leading teams, and helping organizations navigate
		complex technical and organizational challenges.
	</p>

	{
		projects.length > 0 ? (
			<div class="reveal-stagger grid gap-6 md:grid-cols-2">
				{projects.map((entry) => (
					<ProjectCard entry={entry} />
				))}
			</div>
		) : (
			<p class="text-text-muted">No projects published yet.</p>
		)
	}
	<RevealScript />
</Layout>
