---
import Layout from '../../layouts/Layout.astro';
import Button from '../../components/Button.astro';
---

<Layout title="Thanks — Becca Bailey" description="Your message is on its way.">
	<div class="max-w-prose">
		<h1 class="mb-4">Thanks, I got your message</h1>
		<p class="mb-8 text-text-muted">
			I read everything that comes through here and I'll get back to you within a couple of
			business days. In the meantime, if you'd rather just talk it through, you can always book a
			free discovery call.
		</p>
		<Button href="/working" variant="secondary">Back to Work With Me</Button>
	</div>
</Layout>
