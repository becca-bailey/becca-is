---
import EssayLayout from '../../components/writing/EssayLayout.astro';
import { getPublishedWriting } from '@/lib/content';
import { render } from 'astro:content';

export async function getStaticPaths() {
	const posts = await getPublishedWriting();
	return posts.map((entry) => ({
		params: { slug: entry.id },
		props: { entry },
	}));
}

interface Props {
	entry: Awaited<ReturnType<typeof getPublishedWriting>>[number];
}

const { entry } = Astro.props;
const { Content } = await render(entry);
const { title, description } = entry.data;
---

<EssayLayout
	entry={entry}
	title={`${title} — Becca Bailey`}
	description={description}
>
	<Content />
</EssayLayout>
