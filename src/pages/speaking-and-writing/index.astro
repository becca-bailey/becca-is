---
import Layout from '../../layouts/Layout.astro';
import RevealScript from '../../components/RevealScript.astro';
import TimelineEntry from '../../components/technical/TimelineEntry.astro';
import TimelineScript from '../../components/technical/TimelineScript.astro';
import TypeFilterTabs from '../../components/technical/TypeFilterTabs.astro';
import TechnicalCard from '../../components/technical/TechnicalCard.astro';
import { getPublishedTechnical, getRecentOriginalPosts, isOriginalPost } from '@/lib/content';
import { site } from '@/lib/site';

const recentPosts = await getRecentOriginalPosts();
const allEntries = await getPublishedTechnical();
const entries = allEntries.filter((entry) => !isOriginalPost(entry));
---

<Layout
	title="Speaking & Technical Writing — Becca Bailey"
	description={site.speakingAndWritingDescription}
>
	<h1 class="mb-4">Speaking & Technical Writing</h1>
	<p class="reveal editorial-prose mb-10 max-w-prose text-text-muted">
		{site.speakingAndWritingIntro}
	</p>

	{
		recentPosts.length > 0 && (
			<section class="reveal mb-14" aria-labelledby="recent-writing-heading">
				<h2 id="recent-writing-heading" class="mb-6 font-sans text-2xl font-medium">
					Recent writing
				</h2>
				<div class="grid gap-6 sm:grid-cols-2">
					{recentPosts.map((entry) => (
						<TechnicalCard entry={entry} />
					))}
				</div>
			</section>
		)
	}

	{
		entries.length > 0 ? (
			<>
				{recentPosts.length > 0 && (
					<h2 class="reveal mb-6 font-sans text-2xl font-medium">Talks &amp; archive</h2>
				)}
				<div class="reveal">
					<TypeFilterTabs />
				</div>
				<div class="timeline reveal" data-timeline>
					<div class="timeline-track" aria-hidden="true">
						<div class="timeline-progress" data-timeline-progress aria-hidden="true" />
					</div>
					{entries.map((entry) => (
						<TimelineEntry entry={entry} />
					))}
				</div>
			</>
		) : (
			<p class="text-text-muted">Nothing published here yet.</p>
		)
	}

	<RevealScript />
	<TimelineScript />
</Layout>
