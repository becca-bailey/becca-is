---
import { render } from 'astro:content';
import Layout from '../../layouts/Layout.astro';
import RevealScript from '../../components/RevealScript.astro';
import TechnicalDetailActions from '../../components/technical/TechnicalDetailActions.astro';
import TechnicalPreviewFigure from '../../components/technical/TechnicalPreviewFigure.astro';
import TechnicalTypeBadge from '../../components/technical/TechnicalTypeBadge.astro';
import {
	formatDate,
	getTechnicalPreviewAlt,
	getTechnicalPreviewCaption,
	resolveRelatedTechnical,
	technicalIndexUrl,
	technicalUrl,
	getPublishedTechnical,
} from '@/lib/content';

export async function getStaticPaths() {
	const entries = await getPublishedTechnical();
	return entries.map((entry) => ({
		params: { slug: entry.id },
		props: { entry },
	}));
}

const { entry } = Astro.props;
const {
	title,
	summary,
	description,
	pubDate,
	venue,
	host,
	thumbnail,
	type,
	republished,
} = entry.data;

const { Content } = await render(entry);
const hasBody = (entry.body ?? '').trim().length > 0;
const related = await resolveRelatedTechnical(entry.data.related);
const pageDescription = description ?? summary;
const pageTitle = `${title} — Speaking & Technical Writing — Becca Bailey`;
---

<Layout title={pageTitle} description={pageDescription}>
	<article class="max-w-prose">
		<nav class="mb-6" aria-label="Breadcrumb">
			<a
				href={technicalIndexUrl()}
				class="font-sans text-sm text-text underline-offset-4 transition-colors hover:text-[#3D3832] hover:underline"
			>
				&larr; Speaking & Technical Writing
			</a>
		</nav>

		<header class="mb-8">
			<div class="mb-3 flex flex-wrap items-center gap-2">
				<TechnicalTypeBadge type={type} />
				{
					republished && (
						<span class="technical-republished-badge">Republished</span>
					)
				}
				<time class="font-sans text-sm text-text-muted" datetime={pubDate.toISOString()}>
					{formatDate(pubDate)}
				</time>
			</div>
			<h1 class="mb-2">{title}</h1>
			{(venue || host) && <p class="font-sans text-sm text-text-muted">{venue ?? host}</p>}
		</header>

		{
			thumbnail && (
				<TechnicalPreviewFigure
					src={thumbnail}
					alt={getTechnicalPreviewAlt(entry)}
					caption={getTechnicalPreviewCaption(entry)}
				/>
			)
		}

		<aside class="technical-summary editorial-prose" aria-labelledby="summary-heading">
			<h2 id="summary-heading" class="technical-summary-label">Summary</h2>
			<p class="mb-0 leading-[1.75] text-text-muted">{summary}</p>
		</aside>

		<TechnicalDetailActions entry={entry} />

		{
			hasBody && (
				<section class="technical-article mt-10" aria-labelledby="article-heading">
					<h2 id="article-heading" class="sr-only">Article</h2>
					<div class="prose technical-prose">
						<Content />
					</div>
				</section>
			)
		}

		{
			related.length > 0 && (
				<aside class="mt-12 border-t border-border pt-8" aria-labelledby="related-heading">
					<h2 id="related-heading" class="mb-4 font-sans text-lg font-medium">Related</h2>
					<ul class="space-y-2">
						{related.map((item) => (
							<li>
								<a
									href={technicalUrl(item.id)}
									class="font-sans text-text underline-offset-4 transition-colors hover:text-[#3D3832] hover:underline"
								>
									{item.data.title}
								</a>
							</li>
						))}
					</ul>
				</aside>
			)
		}
	</article>
	<RevealScript />
</Layout>
