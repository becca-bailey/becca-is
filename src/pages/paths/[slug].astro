---
import Layout from '../../layouts/Layout.astro';
import RevealScript from '../../components/RevealScript.astro';
import InfluenceList from '../../components/writing/InfluenceList.astro';
import {
	formatDate,
	getDisplayDate,
	getPublishedReadingPaths,
	getWritingForPath,
} from '@/lib/content';

export async function getStaticPaths() {
	const paths = await getPublishedReadingPaths();
	return paths.map((path) => ({
		params: { slug: path.data.slug },
		props: { path },
	}));
}

interface Props {
	path: Awaited<ReturnType<typeof getPublishedReadingPaths>>[number];
}

const { path } = Astro.props;
const essays = await getWritingForPath(path);
const { title, description, themes, externalReading } = path.data;
---

<Layout title={`${title} — Becca Bailey`} description={description}>
	<article class="max-w-prose">
		<p class="mb-6">
			<a
				href="/writing"
				class="font-sans text-sm text-text underline-offset-4 transition-colors hover:text-[#3D3832] hover:underline"
			>
				&larr; Writing
			</a>
		</p>

		<header class="mb-10">
			<p class="mb-2 font-sans text-sm font-medium tracking-wide uppercase text-text-muted">
				Reading path
			</p>
			<h1 class="mb-4">{title}</h1>
			<p class="text-text-muted">{description}</p>
			{
				themes.length > 0 && (
					<ul class="mt-4 flex flex-wrap gap-2">
						{themes.map((theme) => (
							<li>
								<a
									href={`/writing#theme-${theme}`}
									class="font-sans text-sm text-text-muted underline-offset-4 hover:text-text hover:underline"
								>
									{theme}
								</a>
							</li>
						))}
					</ul>
				)
			}
		</header>

		{
			essays.length > 0 ? (
				<section class="mb-12">
					<h2 class="mb-6 font-sans text-xl font-medium tracking-tight">Essays in this path</h2>
					<ol class="space-y-8">
						{essays.map((entry, index) => {
							const displayDate = getDisplayDate(entry);
							return (
								<li class="border-t border-border pt-8 first:border-t-0 first:pt-0">
									<p class="mb-2 font-sans text-sm text-text-muted">
										{index + 1}. <time datetime={displayDate.toISOString()}>{formatDate(displayDate)}</time>
									</p>
									<h3 class="mb-1 font-sans text-2xl font-medium">
										<a
											href={`/writing/${entry.id}`}
											class="text-text no-underline hover:underline"
										>
											{entry.data.title}
										</a>
									</h3>
									{entry.data.subtitle && (
										<p class="mb-2 font-sans text-sm font-medium text-text-muted">
											{entry.data.subtitle}
										</p>
									)}
									<p class="text-text-muted">{entry.data.description}</p>
								</li>
							);
						})}
					</ol>
				</section>
			) : (
				<p class="mb-12 text-text-muted">Essays for this path are coming soon.</p>
			)
		}

		{
			externalReading.length > 0 && (
				<section class="border-t border-border pt-10">
					<InfluenceList items={externalReading} heading="Further reading" />
				</section>
			)
		}
	</article>
	<RevealScript />
</Layout>
