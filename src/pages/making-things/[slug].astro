---
import { Image } from 'astro:assets';
import ProseLayout from '../../layouts/ProseLayout.astro';
import { formatDate, getPublishedProjects, projectImage } from '@/lib/content';
import { render } from 'astro:content';

export async function getStaticPaths() {
	const projects = await getPublishedProjects();
	return projects.map((entry) => ({
		params: { slug: entry.id },
		props: { entry },
	}));
}

interface Props {
	entry: Awaited<ReturnType<typeof getPublishedProjects>>[number];
}

const { entry } = Astro.props;
const { Content } = await render(entry);
const { title, subtitle, description, pubDate } = entry.data;
---

<ProseLayout
	title={`${title} — Becca Bailey`}
	description={description}
	backHref="/making-things"
	backLabel="Projects"
>
	<header slot="header" class="mb-8">
		<div class="project-preview project-preview--framed mb-6">
			<Image
				src={projectImage(entry)}
				alt=""
				class="project-preview-image"
				widths={[768, 1152, 1536, 1920]}
				sizes="(min-width: 768px) 768px, 100vw"
				quality={90}
			/>
		</div>
		{
			pubDate && (
				<time datetime={pubDate.toISOString()} class="mb-2 block font-sans text-sm text-text-muted">
					{formatDate(pubDate)}
				</time>
			)
		}
		<h1 class="mb-2">{title}</h1>
		{subtitle && <p class="mb-3 font-sans text-lg font-medium text-text">{subtitle}</p>}
		<p class="text-text-muted">{description}</p>
	</header>
	<Content />
</ProseLayout>
