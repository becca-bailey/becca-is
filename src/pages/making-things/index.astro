---
import Layout from '../../layouts/Layout.astro';
import ProjectCard from '../../components/ProjectCard.astro';
import RevealScript from '../../components/RevealScript.astro';
import { getPublishedProjects } from '@/lib/content';

const projects = await getPublishedProjects();
---

<Layout
	title="Projects — Becca Bailey"
	description="Software, systems, and hands-on work — technical projects and creative experiments."
>
	<h1 class="mb-4">Projects</h1>
	<p class="reveal mb-10 max-w-prose text-text-muted">
		Some of these projects involve software. Some involve fabric, yarn, or a staple gun. All of them
		reflect things I care about: thoughtful design, careful execution, and making things that last.
	</p>

	{
		projects.length > 0 ? (
			<div class="reveal-stagger grid gap-6 md:grid-cols-2">
				{projects.map((entry) => (
					<ProjectCard entry={entry} />
				))}
			</div>
		) : (
			<p class="text-text-muted">No projects published yet.</p>
		)
	}
	<RevealScript />
</Layout>
