---
import Layout from './Layout.astro';

interface Props {
	title: string;
	role: string;
	description?: string;
}

const { title, role, description } = Astro.props;
const pageTitle = `${role} — ${title}`;
---

<Layout title={pageTitle} description={description}>
	<article class="max-w-prose">
		<header class="mb-8 border-b border-border pb-8">
			<h1>{title}</h1>
			<p class="mt-2 font-sans text-lg text-text-muted md:text-xl">{role}</p>
		</header>

		<div class="prose resume-prose">
			<slot />
		</div>
	</article>
</Layout>
